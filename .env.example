APP_NAME=ClaimIQ
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://claimiq:claimiq_password@localhost:5432/claimiq
DB_ECHO=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / RAG provider: azure_foundry (recommended) or openai
AI_PROVIDER=azure_foundry

# Microsoft Foundry OpenAI-v1 compatible endpoint
AZURE_OPENAI_API_KEY=replace-with-your-foundry-api-key
AZURE_OPENAI_BASE_URL=https://replace-resource.services.ai.azure.com/openai/v1/
AZURE_OPENAI_CHAT_MODEL=gpt-5.6-luna
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional direct OpenAI fallback
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LLM_TIMEOUT_SECONDS=60
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55
RAG_MAX_CONTEXT_CHARS=12000
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_EMBED_BATCH_SIZE=32
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=claimiq_policy_chunks
DOCUMENT_STORAGE_DIRECTORY=./data/documents
MAX_DOCUMENT_SIZE_MB=20
